# ─────────────────────────────────────────── 앱이 읽는 값
# EXPO_PUBLIC_ 접두어가 붙은 것만 Expo 가 앱 번들에 넣는다.
#
# 찾는 곳: 프로젝트 상단 [Connect] 버튼, 또는 Settings > API Keys
#
# 키 이름 주의: Supabase 가 anon/service_role 을 2026년 말까지 폐기 중이라
# 프로젝트에 따라 `anon` 또는 `sb_publishable_...` 로 보인다. 둘 중 보이는 쪽을 넣으면 된다.
# 역할이 같다(공개돼도 되는 키, RLS 로 보호됨).
#
# service_role / sb_secret_ 은 절대 넣지 말 것. RLS 를 통째로 우회하므로
# 앱 번들에 박히는 순간 DB 가 열린다. 그건 Edge Function 만 쓴다.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 시즌(선택). 기본 2026
# EXPO_PUBLIC_SEASON_YEAR=2026

# ─────────────────────────────────────────── 배포에만 쓰는 값 (앱 번들에 안 들어감)
#
# 개인 계정용 액세스 토큰.
# 계정 아이콘 > Account Settings > Access Tokens (https://supabase.com/dashboard/account/tokens)
# 생성 직후 한 번만 보여주므로 바로 복사할 것.
# 발급 페이지를 열 때 "개인 계정으로 로그인된 상태" 인지 확인할 것.
#
# 이걸 쓰면 `supabase login` 이 브라우저를 열지 않는다.
#   - 어느 계정 세션이 잡힐지 헷갈릴 일이 없다 (회사 계정으로 붙는 사고 방지)
#   - 전역 자격 저장소(~/.supabase, 키체인)를 건드리지 않는다
#   - 이 프로젝트 폴더에서만 유효하다
#
# EXPO_PUBLIC_ 접두어가 없으므로 앱 번들에는 절대 들어가지 않는다. 붙이지 말 것.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 브라우저 주소창의 https://supabase.com/dashboard/project/<여기> 부분
SUPABASE_PROJECT_REF=xxxxxxxxxxxx
