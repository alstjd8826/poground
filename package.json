{
  "name": "steelers-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "doctor": "npx expo-doctor",
    "lint": "prettier --check . && eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "icons": "./scripts/generate-icons.sh",
    "legal": "node scripts/legal.mjs && prettier --write src/content/privacy.ts",
    "collectors:test": "deno task test",
    "collectors:dry-run": "deno task dry-run",
    "parsers:verify": "deno task verify",
    "db:deploy": "./scripts/deploy-supabase.sh",
    "db:check": "deno task check-db",
    "format": "prettier --write .",
    "lint:fix": "prettier --write . && eslint . --ext .js,.jsx,.ts,.tsx --fix"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.19.0",
    "@shopify/flash-list": "^2.3.2",
    "@shopify/react-native-skia": "2.6.2",
    "@six33/react-native-bg-removal": "^1.3.4",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "@use-voltra/ios-client": "^2.3.2",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-calendar": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.18",
    "expo-image-picker": "~57.0.18",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.21",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "^57.0.4",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-view-shot": "5.1.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.7.2",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.0",
    "@typescript-eslint/parser": "^8.70.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^57.0.11",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.3.3",
    "react-test-renderer": "19.2.3",
    "supabase": "^2.117.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "index.js",
  "reanimated": {
    "staticFeatureFlags": {
      "ENABLE_SHARED_ELEMENT_TRANSITIONS": true
    }
  },
  "license": "MIT"
}
